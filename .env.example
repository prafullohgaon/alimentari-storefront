# =========================================================================
# ALIMENTARI - PRODUCTION COMMERCE SETUP ENVIRONMENT VARIABLES TEMPLATE
# =========================================================================
# Duplicate this file to .env.local for local development or plug variables
# directly into the Vercel/deployment settings interface.

# -------------------------------------------------------------------------
# 1. SHOPIFY HEADLESS CLIENT CREDENTIALS
# -------------------------------------------------------------------------
# Your custom Shopify store URL domain (e.g. alimentari-store-lshog1qx.myshopify.com)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your_store_domain.myshopify.com

# Shopify Storefront API public access token
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_public_token_here

# Shopify Storefront API private access token (Server-to-Server)
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=your_private_token_here

# Shopify API Version
SHOPIFY_API_VERSION=2026-07

# -------------------------------------------------------------------------
# 2. TELEMETRY, ANALYTICS & CONVERSION PIXELS
# -------------------------------------------------------------------------
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Meta (Facebook) Pixel ID (e.g. 123456789012345)
NEXT_PUBLIC_META_PIXEL_ID=

# TikTok Pixel ID (e.g. CXXXXXXXXXXXX)
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# -------------------------------------------------------------------------
# 3. PRODUCTION MONITORING & ERROR LOGGING
# -------------------------------------------------------------------------
# Sentry DSN URL for runtime client exception reporting
NEXT_PUBLIC_SENTRY_DSN=

# -------------------------------------------------------------------------
# 4. STOREFRONT LOCALE DEFAULTS
# -------------------------------------------------------------------------
# Default language code (e.g. 'it' or 'en')
NEXT_PUBLIC_DEFAULT_LOCALE=it
