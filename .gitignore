# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (secret files ignored, .env.example allowed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local audit, QA, debug, & development scripts
/scripts/
/audit_*.js
/audit_*.mjs
/debug_*.js
/debug_*.mjs
/diagnose_*.js
/diagnose_*.mjs
/find_*.js
/find_*.mjs
/capture_*.js
/investigate_*.js
/investigate_*.mjs
/run_full_visual_acceptance.js
/test_*.js
/test_*.mjs
/verify_*.js
/verify_*.mjs
/controlled_test_results.json
/tmp/
/audit_screenshots/

# Local screenshots / temporary HTML / archives / Excel artifacts
*.png
*.html
*.zip
*.xlsx

# Local PDFs generated during investigation
/src/lib/*.pdf
